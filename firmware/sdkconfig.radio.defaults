# ESP-IDF settings read for the radio image only (spec 021, decision D32), after sdkconfig.defaults:
# `CARGO_TARGET_DIR=target/radio ESP_IDF_SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.radio.defaults"`.
# The UART interrupt runs from internal RAM, so bytes keep arriving while a flash write stalls the
# caches (ESP_INTR_FLAG_IRAM needs it). The other images keep their settings and their figures.
CONFIG_UART_ISR_IN_IRAM=y

# The server of the radio image (spec 023, decision D33). `/ws`: ESP-IDF's WebSocket support is
# gated by this setting (`validate.sh` checks it is in this build only).
CONFIG_HTTPD_WS_SUPPORT=y
# ESP-IDF calls a WebSocket handler for the frames only: `live_ws.rs` checks a new client and sends
# its welcome in the post-handshake callback, on the handshake's request (D37, checked by
# `validate.sh`).
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# A browser's request head is about 500 to 800 bytes (512 by default); a longer one gets 431.
# 4096: the backup's password (up to 128 characters, percent-encoded in a header, up to 1536
# bytes) rides in the head with the browser's own headers and the token (spec 035).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
# The server uses its 12 connections plus 3 sockets of its own (its listener and two UDP control
# sockets), and refuses to start on a smaller table: 15, one spare (10 by default). DHCP, DNS and
# SNTP use lwIP's raw API, no socket.
CONFIG_LWIP_MAX_SOCKETS=16
# lwIP's task on core 0, with Wi-Fi and the server, off the engine's core 1.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# The 4 API workers' stacks are in PSRAM (they never touch the flash, a read neither: D59).
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Wi-Fi's and lwIP's buffers in PSRAM when they can be: internal RAM is the tight resource.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# SNTP: `pool.ntp.org` and the time server the DHCP server gives, when it gives one.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# The engine thread's task watchdog (spec 036 R8): 20 s (at least 5 times the longest flash save
# the thread waits for), and a timeout restarts the chip by a panic, which the supervisor reads at
# the next boot. The other images keep the default (a log line only).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_PANIC=y
# The certificate bundle for https (spec 039 R8, D68): the common list (the authorities of most of
# the web, GitHub's included), not the full one, to keep the image smaller. The release check and
# pull verify the server with it (`esp_crt_bundle_attach`).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
