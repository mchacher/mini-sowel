# ESP-IDF settings for the ESP32 of the Sonoff Dongle Max.
# Rust needs a larger main task stack than the ESP-IDF default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# Flash: 16 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM (2 MB): on, added to the heap (malloc can use it), and the firmware boots without it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# The Dongle Max's ESP32-D0WDR2-V3 is revision 3. Below it, ESP-IDF needs a PSRAM cache
# workaround that only the C compiler applies, which Rust code would not get.
CONFIG_ESP32_REV_MIN_3=y

# Memory placement (spec 015, decision D23). Allocations of up to 4 KB stay in internal RAM,
# larger ones go to PSRAM; 64 KB of internal RAM are kept for DMA and the network stack; mbedTLS
# takes its buffers from PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# A thread may ask for its stack in PSRAM (spec 045: the `script` thread's 32 KB, the API workers').
# Only a thread that never touches the flash, a read neither (D59; `storage.rs` refuses a call
# from such a stack). The radio image sets it too (`sdkconfig.radio.defaults`).
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Partition table (decision D25): `partitions.csv` next to this file. esp-idf-sys does not read a
# custom table from here (its README says to leave CONFIG_PARTITION_TABLE_* out), so the table
# reaches the box through `scripts/box.sh flash`, and QEMU through
# `scripts/qemu.sh`, which builds its image from the same file.

# The data partition is FAT with wear levelling (spec 016): the engine's files have names longer
# than 8.3 (`devices.json`), so long file names are on, their buffer taken from the heap.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# App rollback (spec 032, decision D54): an image booted after an update stays on probation until the
# program confirms it, and the bootloader returns to the previous image after a reset before that.
# It is a BOOTLOADER setting: an update over the air replaces the application, never the
# bootloader, so it reaches the box only through the bootloader that `scripts/box.sh flash` writes.
# Until the box has been flashed once over USB, no image is put on probation and nothing rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Speed (spec 041, script recipes): QuickJS interprets from the flash through the cache, its heap in
# PSRAM. The CPU at its full 240 MHz (160 by default), the flash and the PSRAM at 80 MHz (40 by
# default; the ESP32-D0WDR2-V3's PSRAM takes 80 MHz with the flash at 80). The application's PSRAM
# start-up sets the flash's clock too, so an image installed over the air runs both at 80 MHz (D77).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y
